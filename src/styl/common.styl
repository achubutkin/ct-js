@charset "utf-8"

html, body
    margin 0
    padding 0
    -webkit-user-select none
    position relative
    height 100%
body
    font 16px/32px fonts
    font 16px/32px var(--ui-font)
    color text
    background background
    cursor default
    overflow hidden

:focus
    outline 0

[disabled]
    opacity 0.5
    filter grayscale(1)
    position relative
    &:after
        content ""
        display block
        cursor not-allowed
        top 0
        left 0
        right 0
        bottom 0
        position absolute

.act.act
    color act
.accent1.accent1
    color accent1
.error.error
    color error
.success.success
    color success
.warning.warning
    color warning
.text.text
    color text

.borderall
    border 1px solid borderBright
.borderleft
    border-left 1px solid borderBright
.borderright
    border-right 1px solid borderBright
.bordertop
    border-top 1px solid borderBright
.borderbottom
    border-bottom 1px solid borderBright

.tall
    height 100%
    overflow auto
    box-sizing border-box

// перекрытие
.stretch
    position fixed
    top 0
    left 0
    right 0
    bottom 0

.short
    width 4em

// оверлей загрузки
div#theLoadingScreen
    position fixed
    left 0
    right 0
    top 0
    bottom 0
    line-height 86vh
    text-align center
    z-index 50
    background background
    font-size 4vw
    font-weight 300

.aCodeEditor
    position absolute
    left 0
    top 0
    width 100%
    height 100%

@keyframes rotate
    100%
        transform rotate(360deg)
@keyframes fadeOut
    from
        opacity 1
        visibility visible
    to
        opacity 0
        visibility hidden
.fadeout
    animation forwards 0.5s linear fadeOut

@keyframes jello
    from, to
        transform translate3d(0, 0, 0)
    10%
        transform skewY(12.5deg)
    20%
        transform skewY(-9deg)
    30%
        transform skewY(6.25deg)
    40%
        transform skewY(-3.125deg)
    50%
        transform skewY(1.5625deg)
    70%
        transform skewY(-0.78125deg)
    80%
        transform skewY(0.390625deg)

.jello
    animation-name jello
    transform-origin center
    animation-duration 1s
    animation-fill-mode both

/* Icons */

icon(icon = 'slash', color = act)
    background unquote(
        replace('currentColor', replace(
            '#', '%23', (''+color)
        ), embedurl('./../icons/'+icon+'.svg', 'utf8'))
    ) center center / contain

.feather, .icon
    width 1.5rem
    height 1.5rem
    vertical-align -0.35em
    h1 &, h2 &
        vertical-align bottom

.icon
    stroke none
    fill currentColor
.feather
    stroke currentColor
    stroke-width 2
    stroke-linecap round
    stroke-linejoin round
    fill none
.sfeather
    width 1.4rem
    height 1.1rem
    vertical-align -0.35em
    stroke currentColor
    stroke-width 2
    stroke-linecap round
    stroke-linejoin round
    fill none

.stripedbg.stripedbg
    background linear-gradient(-45deg, background 25%, foreground 25%, foreground 50%, background 50%, background 75%, foreground 75%, foreground)
    background-size 2rem 2rem

/* Color swatches */
[css-swatch="act"]
    color act
[css-swatch="act-contrast"]
    if dark(act)
        color white
    else
        color black
[css-swatch="acttext"]
    color acttext
[css-swatch="acttext-contrast"]
    if dark(acttext)
        color white
    else
        color black
[css-swatch="accent1"]
    color accent1
[css-swatch="accent1-contrast"]
    if dark(accent1)
        color white
    else
        color black
[css-swatch="borderPale"]
    color borderPale
[css-swatch="borderBright"]
    color borderBright
[css-swatch="text"]
    color text
[css-swatch="backgroundDeeper"]
    color backgroundDeeper
[css-swatch="background"]
    color background
[css-swatch="red"]
    color red
[css-swatch="green"]
    color green
[css-swatch="orange"]
    color orange

.soundthumbnail // not perfect, but will have to do
    filter hue-rotate(hue(act)) saturate(saturation(act) * 1.1) contrast(0.75) brightness(max(red(act), green(act), blue(act)) / 100)

.ct-copilot-icon {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    position: relative;
    left: -36px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    opacity: 0.9;
}

.ct-copilot-icon svg {
    width: 24px;
    height: 24px;
}

.ct-copilot-icon:hover {
    opacity: 1;
}

.ct-copilot-selection {
    background: rgba(0, 122, 204, 0.3);
}

.ct-copilot-input-container {
    padding: 0;
    background: #252526;
    border: 1px solid #3e3e42;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    border-radius: 4px;
}

.ct-copilot-input-container:focus-within {
    border-color: #0078d4;
    background: #2d2d2d;
}

.ct-copilot-content-wrapper {
    display: flex;
    gap: 8px;
    padding: 8px;
}

.ct-copilot-input-container textarea {
    background: transparent;
    border: none;
    padding: 8px 10px;
    outline: none;
    flex: 1;
    color: #cccccc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 18px;
    resize: none;
    min-height: 60px;
}

.ct-copilot-input-container textarea::placeholder {
    color: #858585;
}

.ct-copilot-toolbar {
    display: flex;
    flex-shrink: 0;
    align-self: start;
}

.ct-copilot-toolbar button {
    background: transparent;
    color: #cccccc;
    cursor: pointer;
    border-radius: 3px;
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    transition: all 0.15s ease;
    border: none;
    padding: 12px;
}

.ct-copilot-toolbar button:hover {
    background: #3e3e42;
    border-color: #555555;
}

.ct-copilot-toolbar button:active {
    background: #505050;
}

.ct-copilot-close-button svg,
.ct-copilot-send-button svg {
    display: block;
}

.ct-copilot-selection {
    background: rgba(0, 122, 204, 0.3);
}